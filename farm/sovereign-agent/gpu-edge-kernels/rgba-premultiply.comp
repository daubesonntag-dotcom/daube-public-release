#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer PixelBuffer {
  uint pixels[];
} buf;
layout(push_constant) uniform Params {
  uint count;
} params;

uint premul(uint c, uint a) {
  return (c * a + 127u) / 255u;
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= params.count) return;
  uint p = buf.pixels[i];
  uint r = p & 0xffu;
  uint g = (p >> 8u) & 0xffu;
  uint b = (p >> 16u) & 0xffu;
  uint a = (p >> 24u) & 0xffu;
  r = premul(r, a);
  g = premul(g, a);
  b = premul(b, a);
  buf.pixels[i] = r | (g << 8u) | (b << 16u) | (a << 24u);
}
